  "info": {
    "_postman_id": "627a44dd-3ed7-47df-a352-65cd6ee748a9",
    "name": "Aviation Edge Real-Time Reference API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Aviation Edge provides global aviation data including real-time flight\ntracking, historical flight data, flight schedules, airline routes,\ndelays, airport/airline/aircraft reference data, NOTAMs, and satellite\ntracking. All endpoints are JSON over HTTPS GET and require an API key\npassed as the `key` query parameter.\n\n\nContact Support:\n Name: Aviation Edge",
      "type": "text/plain"
    }
  }
